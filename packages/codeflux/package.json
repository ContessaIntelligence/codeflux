{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@codeflux/gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./brand": "./src/brand.ts",
    "./i18n": "./src/i18n/index.ts",
    "./logo": "./src/logo/codeflux-logo.tsx",
    "./wordmark": "./src/logo/codeflux-wordmark.tsx",
    "./providers": "./src/providers/index.ts",
    "./model-filter": "./src/providers/model-filter.ts",
